# Copy to .env and adjust. Every value below is a local-development default.

# --- PostgreSQL (projects and saved configurations) ---
POSTGRES_USER=emf
POSTGRES_PASSWORD=emf
POSTGRES_DB=emf

# --- Backend (variables are read with the EMF_ prefix) ---
# Inside docker compose these two are set from the service names; set them here for native runs.
EMF_DATABASE_URL=postgresql+psycopg://emf:emf@localhost:5432/emf
EMF_REDIS_URL=redis://localhost:6379/0
# Browser origins allowed to call the API directly (comma separated).
EMF_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Largest request (sample points) solved synchronously; larger ones must be queued as jobs.
EMF_SYNC_POINT_LIMIT=400000
# Number of solved results kept in the API's in-memory cache.
EMF_CACHE_ENTRIES=64
# Seconds a queued job's result stays available.
EMF_RESULT_TTL_S=3600

# --- Published host ports (docker compose) ---
FRONTEND_PORT=8080
API_PORT=8000

# --- Optional: container registry mirror (e.g. when Docker Hub rate-limits anonymous pulls) ---
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim
# NODE_IMAGE=mirror.gcr.io/library/node:22-slim
# NGINX_IMAGE=mirror.gcr.io/library/nginx:1.29-alpine
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
# REDIS_IMAGE=mirror.gcr.io/library/redis:7-alpine
